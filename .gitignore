# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# install verification sandbox
/.verify
# stamped build manifest
registry.build.json
src/lib/sources.generated.ts
src/app/glass.generated.css
.verify-*.txt
# built registry (stamped with the deploy URL by pnpm build)
/public/r

# skill mirrors (generated from skills/ by scripts/setup-skills.mjs)
/.claude/skills/
/.agents/skills/
