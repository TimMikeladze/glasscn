{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // live registry source — scripts/verify-native.mjs drops every line naming it
      "@/components/glass/native/*": ["../../registry/native/*"],
      "@/*": ["./src/*"],
      // the registry files live outside this app: resolve their imports from here, not the repo root
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "../../registry/native/*.tsx",
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
